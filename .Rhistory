if(rerun){
# re-run quadratic model
meta_sa_sex <- rma.mv(es, VCV_shared_sa,  mod= ~ poly(c_treattemp, degree=2, raw=TRUE) * Sex.exposed,
random= list(~ 1|study_code,  ~1|obs), data= sdata, method= "REML", test="t")
meta_sa_sex_nointer <- rma.mv(es, VCV_shared_sa,  mod= ~ -1 + poly(c_treattemp, degree=2, raw=TRUE) * Sex.exposed,
random= list(~ 1|study_code,  ~1|obs), data= sdata, method= "REML", test="t")
saveRDS(meta_sa_sex, here("Output", "models", "reproduction", "meta_sa_rep_sex.rds"))
saveRDS(meta_sa_sex_nointer, here("Output", "models", "reproduction", "meta_sa_rep_sex_nointer.rds"))
} else {
meta_sa_sex <- readRDS(here("Output", "models", "reproduction", "meta_sa_rep_sex.rds"))
meta_sa_sex_nointer <- readRDS(here("Output", "models", "reproduction", "meta_sa_rep_sex_nointer.rds"))
}
