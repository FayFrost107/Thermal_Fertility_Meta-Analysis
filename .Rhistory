# Check robustness of the results.
if(rerun){
data_warm <- subset(data_long_final, warm.cool == "Warm")
data_cool <- subset(data_long_final, warm.cool == "Cool")
mv_mlma_split.warm_rbust <- robust(mv_mlma_split.warm, cluster = data_warm$Paper.code, clubSandwich = TRUE)
mv_mlma_split.cool_quad_rbust <- robust(mv_mlma_split.cool_quad, cluster = data_cool$Paper.code, clubSandwich = TRUE)
saveRDS(mv_mlma_split.warm_rbust, here("Output", "models", "multivariate", "mv_mlma_split.warm_rbust.rds"))
saveRDS(mv_mlma_split.cool_quad_rbust, here("Output", "models", "multivariate", "mv_mlma_split.cool_quad_rbust.rds"))
} else {
mv_mlma_split.warm_rbust <- readRDS(here("Output", "models", "multivariate",  "mv_mlma_split.warm_rbust.rds"))
mv_mlma_split.cool_quad_rbust <- readRDS(here("Output", "models", "multivariate",  "mv_mlma_split.cool_quad_rbust.rds"))
}
