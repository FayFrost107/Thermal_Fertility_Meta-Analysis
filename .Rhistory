plot_warm <- ggplot(mlma_warm_data, aes(x = c_treattemp, y = pred.3, col = outcome, linetype = outcome, fill = outcome)) +
geom_ribbon(aes(ymin = c.lb.3, ymax = c.ub.3), alpha = 0.15) +
geom_line() +
scale_color_manual(values = c("purple", "orange"), name = "Trait", labels = c("Longevity", "Reproduction")) +
scale_fill_manual(values = c( "purple","orange"), name = "Trait", labels = c("Longevity", "Reproduction")) +
scale_linetype_manual(values = c("solid", "dashed"), name = "Trait", labels = c("Longevity", "Reproduction")) +
labs(title = "Predicted temperature effect - warm",
x = "Temperature deviation from 25°C",
y = "Effect size",
color = NULL,
fill = NULL,
linetype = NULL) +
theme_bw()
# Prepare Cool plot
plot_cool <- ggplot(mlma_cool_data, aes(x = c_treattemp, y = pred.3, col = outcome, linetype = outcome, fill = outcome)) +
geom_ribbon(aes(ymin = c.lb.3, ymax = c.ub.3), alpha = 0.15) +
geom_line() +
scale_color_manual(values = c( "purple", "orange"), name = "Trait", labels = c("Longevity", "Reproduction")) +
scale_fill_manual(values = c("purple", "orange"), name = "Trait", labels = c("Longevity", "Reproduction")) +
scale_linetype_manual(values = c( "solid", "dashed"), name = "Trait", labels = c("Longevity", "Reproduction")) +
labs(title = "Predicted temperature effect - cool",
x = "Temperature deviation from 25°C",
y = "Effect size",
color = NULL,
fill = NULL,
linetype = NULL) +
theme_bw()
# Combine using patchwork
(plot_warm | plot_cool) + plot_layout(guides = "collect") & theme(legend.position = "bottom")
#| fig-cap-location: bottom
#| fig-width: 15
#| fig-height: 8
library(ggplot2)
library(patchwork)
