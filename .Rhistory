#| label: tbl-sasex
#| tbl-cap: Non-linear effects of temperature and sex exposed on mean effect size of reproduction with most extreme effect sizes removed.
table <- data.frame(Parameters = c("Linear Treatment Temperature (centered) - Both","Quadratic Treatment Temperature (centered) - Both", "Both (mean)", "Females only (mean)", "Treatment Temperature (centered) - Females only","Quadratic Treatment Temperature (centered) - Females only"),
Est. = round(meta_sa_sex$b, 4),
`L 95% CI` = round(meta_sa_sex$ci.lb, 4),
`U 95% CI` = round(meta_sa_sex$ci.ub, 4),
`p-value` = sapply(round(meta_sa_sex$pval,4), function(x) p_value(x)), row.names = NULL, check.names = FALSE)
meta_sa_sex
#| echo: false
#| warning: false
#| include: false
# As before, sex categories are lumped so that we have cases where males are included (Both, Male), versus cases with just females (Female, Parthenogenetic), with Unsure category removed.
# Read in data with lumped sex categories
sex_data <- readRDS(here("Output", "Output data", "reproduction",  "data_rep_sex.rds"))
# Remove outliers
sa_rep_sexdata <- subset(sex_data, es > -10 & es < 10)
saveRDS(sa_rep_sexdata, here("Output", "Output data", "reproduction", "sensitivity_data_rep_sex.rds"))
if(rerun){
# re-compute the covariance matrix for subsetted data
VCV_shared_sa <- impute_covariance_matrix(vi=sa_rep_sexdata$v, cluster = sa_rep_sexdata$shared_control, r=0.5)
# re-run quadratic model
meta_sa_sex <- rma.mv(es, VCV_shared_sa,  mod= ~ poly(c_treattemp, degree=2, raw=TRUE) * Sex.exposed,
random= list(~ 1|study_code,  ~1|obs), data= sa_rep_sexdata, method= "REML", test="t")
meta_sa_sex_nointer <- rma.mv(es, VCV_shared_sa,  mod= ~ -1 + poly(c_treattemp, degree=2, raw=TRUE) * Sex.exposed,
random= list(~ 1|study_code,  ~1|obs), data= sdata, method= "REML", test="t")
saveRDS(meta_sa_sex, here("Output", "models", "reproduction", "meta_sa_rep_sex.rds"))
saveRDS(meta_sa_sex_nointer, here("Output", "models", "reproduction", "meta_sa_rep_sex_nointer.rds"))
} else {
meta_sa_sex <- readRDS(here("Output", "models", "reproduction", "meta_sa_rep_sex.rds"))
meta_sa_sex_nointer <- readRDS(here("Output", "models", "reproduction", "meta_sa_rep_sex_nointer.rds"))
}
