mlma_cool_data$pred.lb.2 <- preds.mlma.cool.2$pi.lb
mlma_cool_data$pred.ub.2 <- preds.mlma.cool.2$pi.ub
mlma_cool_data$c.lb.2 <- preds.mlma.cool.2$ci.lb
mlma_cool_data$c.ub.2 <- preds.mlma.cool.2$ci.ub
# Warm plot
plot_warm <- ggplot(mlma_warm_data, aes(x = c_treattemp, y = pred.2, col = outcome, linetype = outcome, fill = outcome)) +
geom_ribbon(aes(ymin = c.lb.2, ymax = c.ub.2), alpha = 0.15) +
geom_line() +
scale_color_manual(values = c("purple", "orange"), name = "Trait", labels = c("Longevity", "Reproduction")) +
scale_fill_manual(values = c("purple", "orange"), name = "Trait", labels = c("Longevity", "Reproduction")) +
scale_linetype_manual(values = c("solid", "dashed"), name = "Trait", labels = c("Longevity", "Reproduction")) +
labs(title = "Predicted temperature effect - warm (quadratic)",
x = "Temperature deviation from 25°C",
y = "Effect size",
color = NULL,
fill = NULL,
linetype = NULL) +
theme_bw()
