(plot_warm | plot_cool) + plot_layout(guides = "collect") & theme(legend.position = "bottom")
library(ggplot2)
library(patchwork)  # install.packages("patchwork") if not installed
# Warm cubic predictions
preds.mlma.warm.3 <- predict(mv_mlma_split.warm_cubic, addx=TRUE)
mlma_warm_data$pred.3 <- preds.mlma.warm.3$pred
mlma_warm_data$pred.lb.3 <- preds.mlma.warm.3$pi.lb
mlma_warm_data$pred.ub.3 <- preds.mlma.warm.3$pi.ub
mlma_warm_data$c.lb.3 <- preds.mlma.warm.3$ci.lb
mlma_warm_data$c.ub.3 <- preds.mlma.warm.3$ci.ub
# Cool
preds.mlma.cool.3 <- predict(mv_mlma_split.cool_cubic, addx=TRUE)
mlma_cool_data$pred.3 <- preds.mlma.cool.3$pred
mlma_cool_data$pred.lb.3 <- preds.mlma.cool.3$pi.lb
mlma_cool_data$pred.ub.3 <- preds.mlma.cool.3$pi.ub
mlma_cool_data$c.lb.3 <- preds.mlma.cool.3$ci.lb
mlma_cool_data$c.ub.3 <- preds.mlma.cool.3$ci.ub
# Prepare Warm plot
plot_warm <- ggplot(mlma_warm_data, aes(x = c_treattemp, y = pred.3, col = outcome, linetype = outcome, fill = outcome)) +
geom_ribbon(aes(ymin = c.lb.3, ymax = c.ub.3), alpha = 0.15) +
geom_line() +
scale_color_manual(values = c("purple", "orange", name = "Trait", labels = c("Longevity", "Reproduction"))) +
scale_fill_manual(values = c( "purple","orange", name = "Trait", labels = c("Longevity", "Reproduction"))) +
scale_linetype_manual(values = c("solid", "dashed"), name = "Trait", labels = c("Longevity", "Reproduction")) +
labs(title = "Predicted temperature effect - warm",
x = "Temperature deviation from 25°C",
y = "Effect size",
color = NULL,
fill = NULL,
linetype = NULL) +
theme_bw()
# Prepare Cool plot
plot_cool <- ggplot(mlma_cool_data, aes(x = c_treattemp, y = pred.3, col = outcome, linetype = outcome, fill = outcome)) +
geom_ribbon(aes(ymin = c.lb.3, ymax = c.ub.3), alpha = 0.15) +
geom_line() +
scale_color_manual(values = c( "purple", "orange")) +
scale_fill_manual(values = c("purple", "orange")) +
scale_linetype_manual(values = c( "solid", "dashed")) +
labs(title = "Predicted temperature effect - cool",
x = "Temperature deviation from 25°C",
y = "Effect size",
color = NULL,
fill = NULL,
linetype = NULL) +
theme_bw()
# Combine using patchwork
(plot_warm | plot_cool) + plot_layout(guides = "collect") & theme(legend.position = "bottom")
