pest.only <- subset(data_long_final, Agricultural.importance == "Pest")
V_2 <- make_VCV_matrix(data = pest.only, cluster = "trial",  V = "v", rho = 0.5)
V2 <- metaAidR::make_VCV_matrix(data = pest.only, matrix = V_2, cluster = "shared_control",  V = "v", rho = 0.5)
# Check of PD
corpcor::is.positive.definite(V2) # FALSE
# Can bend it to make it PD
V2 <- Matrix::nearPD(V2)$mat
# Check of PD
corpcor::is.positive.definite(V2) # TRUE
mv_mlma_pest.only <- rma.mv(es ~ -1 + outcome + outcome:poly(c_treattemp, degree=3, raw=TRUE), V = V2,
random = list(~outcome - 1 | trial, ~outcome - 1 | Paper.code),
struc = "UN", data = pest.only, test = "t", dfs = "contain")
saveRDS(mv_mlma_pest.only, here("output", "models", "multivariate", "mv_mlma_pest.only.rds"))
} else {
mv_mlma_pest.only <- readRDS(here("output", "models", "multivariate", "mv_mlma_pest.only.rds"))
}
## Remove 'Aquatic' (and 'Both') species form data
terrestrial_species_df_warm <- data_warm[data_warm$Habitat == 'Terrestrial',]
terrestrial_species_df_cool <- data_cool[data_cool$Habitat == 'Terrestrial',]
V_warm_rm_aq <- make_VCV_matrix(data = terrestrial_species_df_warm, cluster = "trial",  V = "v", rho = 0.5)
V2_warm_rm_aq <- metaAidR::make_VCV_matrix(data = terrestrial_species_df_warm, matrix = V_warm_rm_aq, cluster = "shared_control",  V = "v", rho = 0.5)
V2_warm_rm_aq <- Matrix::nearPD(V2_warm_rm_aq)$mat
V_cool_rm_aq <- make_VCV_matrix(data = terrestrial_species_df_cool, cluster = "trial",  V = "v", rho = 0.5)
V2_cool_rm_aq  <- metaAidR::make_VCV_matrix(data = terrestrial_species_df_cool, matrix = V_cool_rm_aq, cluster = "shared_control",  V = "v", rho = 0.5)
V2_cool_rm_aq <- Matrix::nearPD(V2_cool_rm_aq)$mat
if(rerun){
## Rerun warm analysis without aquatic species
mv_mlma_split.warm.report_remove_aquatic <- rma.mv(es ~ -1 + outcome + outcome:c_treattemp, V = V2_warm_rm_aq,
random = list(~outcome - 1 | trial, ~outcome - 1 | Paper.code),
struc = "UN", data = terrestrial_species_df_warm, test = "t", dfs = "contain")
## warm with intercept
mv_mlma_split.warm.report_remove_aquatic.inter <- rma.mv(es ~ outcome:poly(c_treattemp, degree=2, raw=TRUE), V = V2_warm_rm_aq,
random = list(~outcome - 1 | trial,  ~outcome - 1 | Paper.code),
struc = "UN", data = terrestrial_species_df_warm, test = "t", dfs = "contain")
## Rerun cool analysis without aquatic species
mv_mlma_split.cool_quad.report_remove_aquatic <- rma.mv(es ~ -1 + outcome:poly(c_treattemp, degree=2, raw=TRUE), V = V2_cool_rm_aq,
random = list(~outcome - 1 | trial,  ~outcome - 1 | Paper.code),
struc = "UN", data = terrestrial_species_df_cool, test = "t", dfs = "contain")
## cool with intercept
mv_mlma_split.cool_quad.report_remove_aquatic.inter <- rma.mv(es ~ outcome:poly(c_treattemp, degree=2, raw=TRUE), V = V2_cool_rm_aq,
random = list(~outcome - 1 | trial,  ~outcome - 1 | Paper.code),
struc = "UN", data = terrestrial_species_df_cool, test = "t", dfs = "contain")
saveRDS(mv_mlma_split.warm.report_remove_aquatic, here("output", "models", "multivariate", "mv_mlma_split.warm.report_remove_aquatic.rds"))
saveRDS(mv_mlma_split.warm.report_remove_aquatic.inter, here("output", "models", "multivariate", "mv_mlma_split.warm.report_remove_aquatic.inter.rds"))
saveRDS(mv_mlma_split.cool_quad.report_remove_aquatic, here("output", "models", "multivariate", "mv_mlma_split.cool_quad.report_remove_aquatic.rds"))
saveRDS(mv_mlma_split.cool_quad.report_remove_aquatic.inter, here("output", "models", "multivariate", "mv_mlma_split.cool_quad.report_remove_aquatic.inter.rds"))
} else {
mv_mlma_split.warm.report_remove_aquatic <- readRDS(here("output", "models", "multivariate", "mv_mlma_split.warm.report_remove_aquatic.rds"))
mv_mlma_split.warm.report_remove_aquatic.inter <- readRDS(here("output", "models", "multivariate", "mv_mlma_split.warm.report_remove_aquatic.inter.rds"))
mv_mlma_split.cool_quad.report_remove_aquatic <- readRDS(here("output", "models", "multivariate", "mv_mlma_split.cool_quad.report_remove_aquatic.rds"))
mv_mlma_split.cool_quad.report_remove_aquatic.inter <- readRDS(here("output", "models", "multivariate", "mv_mlma_split.cool_quad.report_remove_aquatic.inter.rds"))
}
#| label: tbl-warm-rm-aq
#| tbl-cap: >
#|   Sensitivity Analysis: Effects of temperature on mean effect size for longevity and reproduction
#|   when treatment temperatures are warmer than reference temperatures (with Aquatic species removed).
table <- data.frame(Parameters = c("Longevity (mean)", "Reproduction (mean)",
"Linear Treatment Temperature (centered) - Longevity", "Linear Treatment Temperature (centered) - Reproduction",
"Quadratic Treatment Temperature (centered) - Longevity",   "Quadratic Treatment Temperature (centered) - Reproduction"),
Est. = round(c(mv_mlma_split.warm.report_remove_aquatic.inter$b[1:2],mv_mlma_split.warm.report_remove_aquatic$b[1:4]), 4),
`L 95% CI` = round(c(mv_mlma_split.warm.report_remove_aquatic.inter$ci.lb[1:2],mv_mlma_split.warm.report_remove_aquatic$ci.lb[1:4]), 4),
`U 95% CI` = round(c(mv_mlma_split.warm.report_remove_aquatic.inter$ci.ub[1:2],mv_mlma_split.warm.report_remove_aquatic$ci.ub[1:4]), 4),
`df` = round(c(mv_mlma_split.warm.report_remove_aquatic.inter$ddf[1:2],mv_mlma_split.warm.report_remove_aquatic$ddf[1:4]),2),
`p-value` = sapply(round(c(mv_mlma_split.warm.report_remove_aquatic.inter$pval[1:2],mv_mlma_split.warm.report_remove_aquatic$pval[1:4]),4), function(x) p_value(x)), row.names = NULL, check.names = FALSE)
ft <- flextable(table) %>%
set_table_properties(width = 1, layout = "autofit") %>%
width(j = 1, width = 3.5) %>%  # Parameters column
width(j = 2:5, width = 1.2)    # Other columns
ft
#| label: tbl-cool-rm-aq
#| tbl-cap: >
#|   Sensitivity Analysis: Effects of temperature on mean effect size for longevity and reproduction
#|   when treatment temperatures are cooler than reference temperatures (with Aquatic species removed).
table <- data.frame(Parameters = c("Longevity (mean)", "Reproduction (mean)",
"Linear Treatment Temperature (centered) - Longevity", "Linear Treatment Temperature (centered) - Reproduction",
"Quadratic Treatment Temperature (centered) - Longevity",   "Quadratic Treatment Temperature (centered) - Reproduction"),
Est. = round(c(mv_mlma_split.cool_quad.report_remove_aquatic.inter$b[1:2],mv_mlma_split.cool_quad.report_remove_aquatic$b[1:4]), 4),
`L 95% CI` = round(c(mv_mlma_split.cool_quad.report_remove_aquatic.inter$ci.lb[1:2],mv_mlma_split.cool_quad.report_remove_aquatic$ci.lb[1:4]), 4),
`U 95% CI` = round(c(mv_mlma_split.cool_quad.report_remove_aquatic.inter$ci.ub[1:2],mv_mlma_split.cool_quad.report_remove_aquatic$ci.ub[1:4]), 4),
`df` = round(c(mv_mlma_split.cool_quad.report_remove_aquatic.inter$ddf[1:2],mv_mlma_split.cool_quad.report_remove_aquatic$ddf[1:4]),2),
`p-value` = sapply(round(c(mv_mlma_split.cool_quad.report_remove_aquatic.inter$pval[1:2],mv_mlma_split.cool_quad.report_remove_aquatic$pval[1:4]),4), function(x) p_value(x)), row.names = NULL, check.names = FALSE)
ft <- flextable(table) %>%
set_table_properties(width = 1, layout = "autofit") %>%
width(j = 1, width = 3.5) %>%  # Parameters column
width(j = 2:5, width = 1.2)    # Other columns
ft
## Remove studies with assumed rearing temp from data
rearing_species_df_warm <- data_warm[!is.na(data_warm$Rearing.temperature),]
rearing_species_df_cool <- data_cool[!is.na(data_cool$Rearing.temperature),]
V_warm_rm_rear <- make_VCV_matrix(data = rearing_species_df_warm, cluster = "trial",  V = "v", rho = 0.5)
V2_warm_rm_rear <- metaAidR::make_VCV_matrix(data = rearing_species_df_warm, matrix = V_warm_rm_rear, cluster = "shared_control",  V = "v", rho = 0.5)
V2_warm_rm_rear <- Matrix::nearPD(V2_warm_rm_rear)$mat
V_cool_rm_rear <- make_VCV_matrix(data = rearing_species_df_cool, cluster = "trial",  V = "v", rho = 0.5)
V2_cool_rm_rear  <- metaAidR::make_VCV_matrix(data = rearing_species_df_cool, matrix = V_cool_rm_rear, cluster = "shared_control",  V = "v", rho = 0.5)
V2_cool_rm_rear <- Matrix::nearPD(V2_cool_rm_rear)$mat
if(rerun){
## Rerun warm analysis without assumed rearing temp studies
mv_mlma_split.warm.report_remove_rear <- rma.mv(es ~ -1 + outcome + outcome:c_treattemp, V = V2_warm_rm_rear,
random = list(~outcome - 1 | trial, ~outcome - 1 | Paper.code),
struc = "UN", data = rearing_species_df_warm, test = "t", dfs = "contain")
mv_mlma_split.warm.report_remove_rear.inter <- rma.mv(es ~ outcome + outcome:c_treattemp, V = V2_warm_rm_rear,
random = list(~outcome - 1 | trial, ~outcome - 1 | Paper.code),
struc = "UN", data = rearing_species_df_warm, test = "t", dfs = "contain")
## Rerun cool analysis without assumed rearing temp studies
mv_mlma_split.cool_quad.report_remove_rear <- rma.mv(es ~ -1 + outcome:poly(c_treattemp, degree=2, raw=TRUE), V = V2_cool_rm_rear,                                     random = list(~outcome - 1 | trial,  ~outcome - 1 | Paper.code),
struc = "UN", data = rearing_species_df_cool, test = "t", dfs = "contain")
mv_mlma_split.cool_quad.report_remove_rear.inter <- rma.mv(es ~ outcome:poly(c_treattemp, degree=2, raw=TRUE), V = V2_cool_rm_rear,                                    random = list(~outcome - 1 | trial,  ~outcome - 1 | Paper.code),
struc = "UN", data = rearing_species_df_cool, test = "t", dfs = "contain")
saveRDS(mv_mlma_split.warm.report_remove_rear, here("output", "models", "multivariate", "mv_mlma_split.warm.report_remove_rear.rds"))
saveRDS(mv_mlma_split.warm.report_remove_rear.inter, here("output", "models", "multivariate", "mv_mlma_split.warm.report_remove_rear.inter.rds"))
saveRDS(mv_mlma_split.cool_quad.report_remove_rear, here("output", "models", "multivariate", "mv_mlma_split.cool_quad.report_remove_rear.rds"))
saveRDS(mv_mlma_split.cool_quad.report_remove_rear.inter, here("output", "models", "multivariate", "mv_mlma_split.cool_quad.report_remove_rear.inter.rds"))
}else{
mv_mlma_split.warm.report_remove_rear <- readRDS(here("output", "models", "multivariate", "mv_mlma_split.warm.report_remove_rear.rds"))
mv_mlma_split.warm.report_remove_rear.inter <- readRDS(here("output", "models", "multivariate", "mv_mlma_split.warm.report_remove_rear.inter.rds"))
mv_mlma_split.cool_quad.report_remove_rear <- readRDS(here("output", "models", "multivariate", "mv_mlma_split.cool_quad.report_remove_rear.rds"))
mv_mlma_split.cool_quad.report_remove_rear.inter <- readRDS(here("output", "models", "multivariate", "mv_mlma_split.cool_quad.report_remove_rear.inter.rds"))
}
#| label: tbl-warm-rm-rear
#| tbl-cap: >
#|   Sensitivity Analysis: Effects of temperature on mean effect size for longevity and reproduction
#|   when treatment temperatures are warmer than reference temperatures (with assuemd rearing temp studies removed).
table <- data.frame(Parameters = c("Longevity (mean)", "Reproduction (mean)",
"Linear Treatment Temperature (centered) - Longevity", "Linear Treatment Temperature (centered) - Reproduction",
"Quadratic Treatment Temperature (centered) - Longevity",   "Quadratic Treatment Temperature (centered) - Reproduction"),
Est. = round(c(mv_mlma_split.warm.report_remove_rear.inter$b[1:2],mv_mlma_split.warm.report_remove_rear$b[1:4]), 4),
`L 95% CI` = round(c(mv_mlma_split.warm.report_remove_rear.inter$ci.lb[1:2],mv_mlma_split.warm.report_remove_rear$ci.lb[1:4]), 4),
`U 95% CI` = round(c(mv_mlma_split.warm.report_remove_rear.inter$ci.ub[1:2],mv_mlma_split.warm.report_remove_rear$ci.ub[1:4]), 4),
`df` = round(c(mv_mlma_split.warm.report_remove_rear.inter$ddf[1:2],mv_mlma_split.warm.report_remove_rear$ddf[1:4]),2),
`p-value` = sapply(round(c(mv_mlma_split.warm.report_remove_rear.inter$pval[1:2],mv_mlma_split.warm.report_remove_rear$pval[1:4]),4), function(x) p_value(x)), row.names = NULL, check.names = FALSE)
ft <- flextable(table) %>%
set_table_properties(width = 1, layout = "autofit") %>%
width(j = 1, width = 3.5) %>%  # Parameters column
width(j = 2:5, width = 1.2)    # Other columns
ft
