library(ggplot2)
library(patchwork)
# Warm
preds.mlma.warm.2 <- predict(mv_mlma_split.warm_quad, addx=TRUE)
mlma_warm_data$pred.2 <- preds.mlma.warm.2$pred
mlma_warm_data$pred.lb.2 <- preds.mlma.warm.2$pi.lb
mlma_warm_data$pred.ub.2 <- preds.mlma.warm.2$pi.ub
mlma_warm_data$c.lb.2 <- preds.mlma.warm.2$ci.lb
mlma_warm_data$c.ub.2 <- preds.mlma.warm.2$ci.ub
p_warm <- ggplot(data = mlma_warm_data, aes(x = c_treattemp, y = pred.2, col = outcome, linetype = outcome)) +
geom_ribbon(aes(ymin = c.lb.2, ymax = c.ub.2, fill = outcome), alpha = 0.15) +
geom_line() +
scale_color_manual(values = c("red", "blue"), name = "Trait", labels = c("Longevity", "Reproduction")) +
scale_fill_manual(values = c("red", "blue"), name = "Trait", labels = c("Longevity", "Reproduction")) +
scale_linetype_manual(values = c("solid", "dashed"), labels = c("Longevity", "Reproduction"), name="Trait") +
scale_x_continuous(breaks=c(-5, 0, 5, 10, 15, 20), labels=c("20", "25", "30", "35", "40", "45")) +
theme_bw() +
labs(title = "Predicted temperature effects on warm studies",
x = "Experimental temperature (°C)",
y = "Standardised change in life history trait")
# Cool
preds.mlma.cool.2 <- predict(mv_mlma_split.cool_quad, addx=TRUE)
mlma_cool_data$pred.2 <- preds.mlma.cool.2$pred
mlma_cool_data$pred.lb.2 <- preds.mlma.cool.2$pi.lb
mlma_cool_data$pred.ub.2 <- preds.mlma.cool.2$pi.ub
mlma_cool_data$c.lb.2 <- preds.mlma.cool.2$ci.lb
mlma_cool_data$c.ub.2 <- preds.mlma.cool.2$ci.ub
p_cool <- ggplot(data = mlma_cool_data, aes(x = c_treattemp, y = pred.2, col = outcome, linetype = outcome)) +
geom_ribbon(aes(ymin = c.lb.2, ymax = c.ub.2, fill = outcome), alpha = 0.15) +
geom_line() +
scale_color_manual(values = c("red", "blue"), name = "Trait", labels = c("Longevity", "Reproduction")) +
scale_fill_manual(values = c("red", "blue"), name = "Trait", labels = c("Longevity", "Reproduction")) +
scale_linetype_manual(values = c("solid", "dashed"), labels = c("Longevity", "Reproduction"), name="Trait") +
scale_x_continuous(breaks=c(-25, -20, -15, -10, -5, 0), labels=c("0", "5", "10", "15", "20", "25")) +
theme_bw() +
labs(title = "Predicted temperature effects on cool studies",
x = "Experimental temperature (°C)",
y = "Standardised change in life history trait")
# Combine plots
p_cool + p_warm
